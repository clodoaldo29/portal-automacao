{
  // Static site: Vite builds into dist/ and Cloudflare serves those files, with no server code.
  "name": "portal-automacao",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
